rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPERS =====
    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }

    // author ή admin μπορεί να δημιουργεί περιεχόμενο
    function isAuthor() {
      return isSignedIn() && (getRole() == 'author' || getRole() == 'admin');
    }

    // ===== USERS =====
    // Admin: πλήρης πρόσβαση.
    // Χρήστης: μπορεί να δημιουργήσει ΜΟΝΟ το δικό του doc, και ΜΟΝΟ αν
    //   υπάρχει invite για το email του με τον ίδιο ρόλο (invite claiming).
    match /users/{uid} {
      allow read:   if request.auth.uid == uid || isAdmin();
      allow create: if isAdmin()
                    || (isSignedIn()
                        && request.auth.uid == uid
                        && get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.role
                           == request.resource.data.role);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===== INVITES =====
    // Admin: πλήρης πρόσβαση.
    // Logged-in χρήστης: μπορεί να διαβάσει και να διαγράψει ΜΟΝΟ το δικό του invite
    //   (το doc ID είναι το lowercase email).
    match /invites/{email} {
      allow read:          if isAdmin() || (isSignedIn() && request.auth.token.email.lower() == email);
      allow create, update: if isAdmin();
      allow delete:        if isAdmin() || (isSignedIn() && request.auth.token.email.lower() == email);
    }

    // ===== ARTICLES =====
    match /articles/{docId} {
      allow read: if resource.data.status == 'published' || isAdmin()
                  || (isAuthor() && resource.data.authorUid == request.auth.uid);

      allow create: if isAdmin()
                    || (isAuthor()
                        && request.resource.data.status == 'pending'
                        && request.resource.data.authorUid == request.auth.uid);

      allow update: if isAdmin()
                    || (isAuthor()
                        && resource.data.authorUid == request.auth.uid
                        // Ο συντακτης δεν αλλαζει μονος του το status: δημοσιευει ο admin.
                        && !('status' in request.resource.data.diff(resource.data).affectedKeys())
                        )
                    // Δημόσιος μετρητής προβολών (js/traffic.js): ΜΟΝΟ το viewCount,
                    // ΜΟΝΟ αύξηση, ΜΟΝΟ σε δημοσιευμένα άρθρα.
                    || (resource.data.status == 'published'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
                        && request.resource.data.viewCount is int
                        && request.resource.data.viewCount > resource.data.get('viewCount', 0));

      allow delete: if isAdmin()
                    || (isAuthor() && resource.data.authorUid == request.auth.uid);
    }

    // ===== ANNOUNCEMENTS =====
    match /announcements/{docId} {
      allow read: if resource.data.status == 'published' || isAdmin()
                  || (isAuthor() && resource.data.authorUid == request.auth.uid);

      allow create: if isAdmin()
                    || (isAuthor()
                        && request.resource.data.status == 'pending'
                        && request.resource.data.authorUid == request.auth.uid);

      allow update: if isAdmin()
                    || (isAuthor() && resource.data.authorUid == request.auth.uid
                        && !('status' in request.resource.data.diff(resource.data).affectedKeys()))
                    // Δημόσιος μετρητής προβολών (js/traffic.js): ΜΟΝΟ το viewCount,
                    // ΜΟΝΟ αύξηση, ΜΟΝΟ σε δημοσιευμένες ανακοινώσεις.
                    || (resource.data.status == 'published'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
                        && request.resource.data.viewCount is int
                        && request.resource.data.viewCount > resource.data.get('viewCount', 0));

      allow delete: if isAdmin()
                    || (isAuthor() && resource.data.authorUid == request.auth.uid);
    }

    // ===== GALLERY =====
    match /gallery/{docId} {
      allow read: if resource.data.status == 'published' || isAdmin()
                  || (isAuthor() && resource.data.uploadedByUid == request.auth.uid);

      allow create: if isAdmin()
                    || (isAuthor()
                        && request.resource.data.status == 'pending'
                        && request.resource.data.uploadedByUid == request.auth.uid);

      allow update: if isAdmin();

      allow delete: if isAdmin()
                    || (isAuthor() && resource.data.uploadedByUid == request.auth.uid);
    }

    // ===== ACTIONS =====
    match /actions/{docId} {
      allow read: if resource.data.status == 'published' || isAdmin()
                  || (isAuthor() && resource.data.authorUid == request.auth.uid);

      allow create: if isAdmin()
                    || (isAuthor()
                        && request.resource.data.status == 'pending'
                        && request.resource.data.authorUid == request.auth.uid);

      allow update: if isAdmin()
                    || (isAuthor()
                        && resource.data.authorUid == request.auth.uid
                        // Ο συντακτης δεν αλλαζει μονος του το status: δημοσιευει ο admin.
                        && !('status' in request.resource.data.diff(resource.data).affectedKeys())
                        )
                    // Δημόσιος μετρητής προβολών (js/traffic.js): ΜΟΝΟ το viewCount,
                    // ΜΟΝΟ αύξηση, ΜΟΝΟ σε δημοσιευμένες δράσεις.
                    || (resource.data.status == 'published'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
                        && request.resource.data.viewCount is int
                        && request.resource.data.viewCount > resource.data.get('viewCount', 0));

      allow delete: if isAdmin()
                    || (isAuthor() && resource.data.authorUid == request.auth.uid);
    }

    // ===== CONTACT MESSAGES =====
    // Οριa σχηματος και μεγεθους: χωρις αυτα, οποιοσδηποτε γραφει εγγραφα
    // του 1MB απευθειας στη βαση, χωρις να ανοιξει καν το site, και φουσκωνει
    // το κοστος και τη λιστα μηνυματων.
    match /contactMessages/{docId} {
      // Εδω γραφουν ΔΥΟ φορμες: η επικοινωνια της αρχικης (name/email/message)
      // και το «θελεις να γινεις χορηγος;» της sponsors.html, που στελνει
      // επιπλεον type/company/phone. Αν λειπουν απο τη λιστα, η φορμα χορηγων
      // σπαει σιωπηλα.
      allow create: if request.resource.data.keys()
                         .hasOnly(['name', 'email', 'message', 'createdAt', 'read',
                                   'type', 'company', 'phone'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 3000
                    && request.resource.data.get('type', '') is string
                    && request.resource.data.get('type', '').size() <= 20
                    && request.resource.data.get('company', '') is string
                    && request.resource.data.get('company', '').size() <= 150
                    && request.resource.data.get('phone', '') is string
                    && request.resource.data.get('phone', '').size() <= 40;
      allow read, update, delete: if isAdmin();
    }

    // ===== VOLUNTEERS =====
    match /volunteers/{docId} {
      allow create: if request.resource.data.keys()
                         .hasOnly(['name', 'email', 'phone', 'interests',
                                   'message', 'createdAt', 'read'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.get('phone', '') is string
                    && request.resource.data.get('phone', '').size() <= 40
                    && (!('interests' in request.resource.data)
                        || (request.resource.data.interests is list
                            && request.resource.data.interests.size() <= 20))
                    && request.resource.data.get('message', '') is string
                    && request.resource.data.get('message', '').size() <= 3000;
      allow read, update, delete: if isAdmin();
    }

    // ===== SPONSORS =====
    // Δημόσια ανάγνωση (σελίδα χορηγών) — διαχείριση μόνο από admin.
    match /sponsors/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===== SITE TRAFFIC (js/traffic.js) — pageviews/unique visitors, 1 doc ανά ημέρα =====
    // Public write (και ανώνυμοι επισκέπτες), αλλά ΜΟΝΟ increment-style updates
    // στα 4 επιτρεπτά fields. Read μόνο admin (για το panel).
    match /analytics/{day} {
      function trafficDocValid() {
        return request.resource.data.keys()
                 .hasOnly(['totalViews', 'uniqueVisitors', 'pageBreakdown', 'lastUpdated'])
               && request.resource.data.totalViews is int
               && request.resource.data.totalViews >= 0
               && (!('uniqueVisitors' in request.resource.data)
                   || (request.resource.data.uniqueVisitors is int
                       && request.resource.data.uniqueVisitors >= 0))
               // Οριο κλειδιων στον χαρτη σελιδων. Χωρις αυτο, οποιοσδηποτε
               // προσθετει ψευτικα κλειδια μεχρι να φτασει το εγγραφο το οριο
               // του 1MB και να σπασουν τα στατιστικα ολης της ημερας.
               && (!('pageBreakdown' in request.resource.data)
                   || (request.resource.data.pageBreakdown is map
                       && request.resource.data.pageBreakdown.keys().size() <= 300));
      }

      // Καθε εγγραφη μετραει ΤΟ ΠΟΛΥ μια προβολη και εναν επισκεπτη, ακριβως
      // οπως κανει το traffic.js με increment(1). Χωρις αυτο, το ">=" επετρεπε
      // σε οποιονδηποτε να γραψει 999999 προβολες με μια κληση: δεν μπορουσε να
      // μηδενισει τα στατιστικα, μπορουσε ομως να τα κανει αχρηστα.
      function stepOk(field) {
        return request.resource.data.get(field, 0) >= resource.data.get(field, 0)
               && request.resource.data.get(field, 0) <= resource.data.get(field, 0) + 1;
      }

      allow read, delete: if isAdmin();
      allow create: if day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                    && trafficDocValid()
                    && request.resource.data.totalViews <= 1
                    && request.resource.data.get('uniqueVisitors', 0) <= 1;
      allow update: if day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                    && trafficDocValid()
                    && stepOk('totalViews')
                    && stepOk('uniqueVisitors');
    }

    // ===== ΡΥΘΜΙΣΕΙΣ ΣΙΤΕ =====
    // Δημοσια αναγνωσιμες: τις διαβαζει καθε σελιδα για να ξερει αν ειναι
    // ενεργη η λειτουργια συντηρησης. Τις γραφει μονο ο διαχειριστης.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== NEWSLETTER =====
    // Ο καθένας μπορεί να εγγραφεί (create με doc ID = email).
    // Δεν επιτρέπεται update: έτσι η διπλοεγγραφή απορρίπτεται
    // και κανείς δεν μπορεί να πειράξει υπάρχουσα εγγραφή.
    match /newsletter/{email} {
      allow create: if request.resource.data.keys()
                         .hasOnly(['email', 'lang', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email == email
                    && email.size() <= 254
                    && request.resource.data.get('lang', '') is string
                    && request.resource.data.get('lang', '').size() <= 5;
      allow read, update, delete: if isAdmin();
    }
  }
}
